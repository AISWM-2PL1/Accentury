# syntax=docker/dockerfile:1
# 가짜 엔진 전용 이미지 - 로컬 풀스택(루트 docker-compose.yml)이 쓴다 (KAN-22, PR #87 리뷰 반영).
#   docker build -f ai/Dockerfile.fake -t accentury-ai:fake ai
#
# 운영 이미지(ai/Dockerfile)는 베이스가 채점 모델 전달본(linux/amd64, 4GB대)이라 개발 기계에서
# 뜨지 않는다. 이 이미지는 같은 FastAPI 앱을 slim 파이썬 위에 얹고 ACCENTURY_AI_ANALYSIS_ENGINE=fake로
# 띄운다 - 전달본이 없으니 실모델 어댑터는 임포트조차 되지 않고, 점수는 해시다 (app/fake.py).
# 배포에는 쓸 수 없다 - 앱이 ACCENTURY_AI_INTERNAL_TOKEN_REQUIRED=true(배포 compose)와 fake의 조합을
# 기동 시 거부한다.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    ACCENTURY_AI_ANALYSIS_ENGINE=fake

WORKDIR /app
COPY requirements.txt ./service-requirements.txt
RUN pip install --no-cache-dir -r service-requirements.txt
COPY app app

RUN groupadd --system --gid 10001 accentury \
 && useradd --system --uid 10001 --gid accentury --home-dir /app --shell /usr/sbin/nologin accentury \
 && chown -R accentury:accentury /app
USER accentury

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
