<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Debug 전용 plist. Release는 Info-Release.plist를 쓰며, 어느 쪽을 쓸지는
	     Config/{Debug,Release}.xcconfig의 INFOPLIST_FILE이 고른다. 두 파일로 나눈 이유는
	     아래 NSAppTransportSecurity 블록 하나 때문이다 — 이 블록이 릴리스 빌드에
	     실려 나가는 경로를 애초에 만들지 않는다. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>ko</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleDisplayName</key>
	<string>Accentury</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- 런치 스크린 (KAN-178). 스토리보드 파일 대신 이 딕셔너리를 쓴다 — iOS 14부터
	     UILaunchScreen이 정식 경로이고, 우리 런치 화면은 "크림 배경 + 가운데 아이콘" 한 장이라
	     스토리보드가 들고 오는 xib 파일·오토레이아웃·씬 편집이 전부 값 두 개로 줄어든다.
	     UIColorName·UIImageName은 **에셋 카탈로그의 이름**이지 파일명이 아니다
	     (Assets.xcassets의 LaunchBackground.colorset · LaunchIcon.imageset).
	     안드로이드 쪽 짝은 themes.xml의 Theme.Accentury.Starting이고, 배경색·아이콘 도상이
	     같은 원본(assets/app-icon/source.png)에서 나온다.
	     UIImageRespectsSafeAreaInsets는 노치·다이내믹 아일랜드에 아이콘이 물리지 않게 한다. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchIcon</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<true/>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<!-- 빌드 설정에서 흘러드는 주소. 값의 출처는 Config/Debug.xcconfig다 (AppConfig.swift가 읽는다). -->
	<key>WEB_URL</key>
	<string>$(WEB_URL)</string>
	<key>API_BASE_URL</key>
	<string>$(API_BASE_URL)</string>

	<!-- 가짜 마이크로 쓸 WAV 파일명(또는 맥의 절대 경로). 값의 출처는 Config/Debug.xcconfig이고
	     보통은 빈 문자열이라 실제 마이크를 쓴다. 이 키는 Info-Release.plist에 **없다** -
	     안드로이드가 FilePcmSource를 src/debug 소스셋에 둬서 릴리스 dex에서 지운 것과 같은 자리다. -->
	<key>FAKE_MIC_ASSET</key>
	<string>$(FAKE_MIC_ASSET)</string>

	<!-- 마이크 권한 안내 문구 (FR-OB-04). iOS는 이 문자열이 없으면 권한 요청 순간 앱이 죽는다. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>억양 분석을 위해 마이크로 목소리를 녹음해요. 녹음은 분석 후 즉시 삭제돼요.</string>

	<!-- ATS 예외: 맥에서 도는 dev 서버(http://localhost:5173, :8080)로 평문 접속을 연다.
	     안드로이드의 network_security_config.xml이 10.0.2.2에만 평문을 열어 준 것과 같은 자리다.
	     NSAllowsLocalNetworking은 점 없는 호스트명(localhost)과 .local을 덮고, 명시적
	     localhost 예외는 루프백 주소 표기가 갈릴 때를 위한 보험이다.
	     NSAllowsArbitraryLoads는 쓰지 않는다 — 그건 전 세계 평문을 여는 스위치라
	     dev 서버 하나 때문에 켤 값이 아니고, 실기기 확인은 HTTPS 터널로 한다. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
