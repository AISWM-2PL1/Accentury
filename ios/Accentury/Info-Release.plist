<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Release 전용 plist. Info-Debug.plist와 여기만 다르다: NSAppTransportSecurity 키가
	     아예 없다 = ATS 기본값(https 강제)이 그대로 산다. 구성별 예외를 빌드 설정 한 줄로
	     끄고 켜는 대신 파일을 나눈 이유가 이것이다 — 릴리스 plist에 평문 예외를 넣으려면
	     이 파일을 고쳐야 하고, 그건 리뷰에 걸린다. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>ko</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleDisplayName</key>
	<string>Accentury</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- 런치 스크린 (KAN-178). 스토리보드 파일 대신 이 딕셔너리를 쓴다 — iOS 14부터
	     UILaunchScreen이 정식 경로이고, 우리 런치 화면은 "크림 배경 + 가운데 아이콘" 한 장이라
	     스토리보드가 들고 오는 xib 파일·오토레이아웃·씬 편집이 전부 값 두 개로 줄어든다.
	     UIColorName·UIImageName은 **에셋 카탈로그의 이름**이지 파일명이 아니다
	     (Assets.xcassets의 LaunchBackground.colorset · LaunchIcon.imageset).
	     안드로이드 쪽 짝은 themes.xml의 Theme.Accentury.Starting이고, 배경색·아이콘 도상이
	     같은 원본(assets/app-icon/source.png)에서 나온다.
	     UIImageRespectsSafeAreaInsets는 노치·다이내믹 아일랜드에 아이콘이 물리지 않게 한다. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchIcon</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<true/>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<!-- 번들 폰트 등록 (KAN-178). Info-Debug.plist와 같은 값이다 — 디버그 전용 자산이 아니라
	     화면 자체가 쓰는 서체라 릴리스에도 그대로 실린다 (FAKE_MIC_ASSET과 갈리는 지점). -->
	<key>UIAppFonts</key>
	<array>
		<string>Jua-Regular.ttf</string>
	</array>

	<!-- 빌드 설정에서 흘러드는 주소. 값의 출처는 Config/Release.xcconfig다 (AppConfig.swift가 읽는다). -->
	<key>WEB_URL</key>
	<string>$(WEB_URL)</string>
	<key>API_BASE_URL</key>
	<string>$(API_BASE_URL)</string>

	<!-- 카카오 네이티브 앱 키 (KAN-180). 값의 출처는 Config/Base.xcconfig이고 **기본은 빈 문자열**이다 —
	     그 상태가 정상이며 카카오 경로가 꺼진 것을 뜻한다(AppConfig.kakaoNativeAppKey가 nil이 되고
	     AccenturyApp이 initSDK를 건너뛴다). 안드로이드 local.properties의 `kakaoNativeAppKey=`
	     미설정과 같은 자리다. 키를 레포에 두지 않으므로 이 plist에도 값이 아니라 변수만 있다. -->
	<key>KAKAO_NATIVE_APP_KEY</key>
	<string>$(KAKAO_NATIVE_APP_KEY)</string>

	<!-- 카톡이 깔려 있는지 물어볼 수 있는 스킴 (KAN-180). iOS는 `canOpenURL`로 조회할 스킴을
	     여기 선언해 두지 않으면 설치돼 있어도 무조건 false를 돌려준다 — SDK의
	     `isKakaoTalkSharingAvailable`이 그 위에 서 있으므로, 이 배열이 빠지면 카카오 경로가
	     조용히 죽고 늘 공유 시트로만 간다(빌드도 실행도 멀쩡하다).
	     `kakaolink`가 공유용이고 `kakaokompassauth`는 카카오 로그인용인데, 로그인을 쓰지 않아도
	     SDK 내부가 조회하므로 카카오 문서가 둘을 함께 넣으라고 한다. `kakaoplus`(채널)는 쓰지
	     않으므로 넣지 않는다 — 선언한 스킴은 앱이 무엇을 들여다볼 수 있는지의 목록이다. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>kakaokompassauth</string>
		<string>kakaolink</string>
	</array>

	<!-- 카톡이 공유를 마치고 우리 앱으로 돌아오는 입구 (KAN-180). 형식은 카카오가 정한
	     `kakao{네이티브 앱 키}`라 위 키에서 파생된다 — 그래서 여기도 값이 아니라 변수다.
	     Universal Links(Accentury.entitlements, KAN-32)와 다른 통로다: 그쪽은 웹 주소로 들어오는
	     신규 유입이고, 이건 카톡에서 우리 앱으로 되돌아오는 복귀 경로다.
	     **키가 빈 빌드에서는 이 값이 `kakao` 한 단어가 된다.** 되돌아올 카톡 전환 자체가 없는
	     상태(SDK 미초기화)라 쓰이지 않는 스킴이고, 스토어로 나가는 빌드는 키가 주입돼 있다. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER).kakao</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>kakao$(KAKAO_NATIVE_APP_KEY)</string>
			</array>
		</dict>
	</array>

	<!-- 광고 관련 동의 기본값을 끈다 (KAN-33). 웹에서 `allow_google_signals`·
	     `allow_ad_personalization_signals`를 끈 것과 같은 요구이고, 안드로이드 매니페스트의
	     `google_analytics_adid_collection_enabled=false` 자리다.
	     iOS 계측 SDK의 광고 식별자(IDFA) 수집은 사실 이 값들이 아니라 **무엇을 링크했는가**로
	     갈리고, 우리는 `FirebaseAnalyticsCore` product를 골라 측정 라이브러리에서 수집 코드를 뺐다
	     (ios/project.yml). 그래서 이 세 줄은 이미 꺼진 것을 한 번 더 끄는 셈인데, 설정에도
	     적어 두는 이유는 product를 되돌리는 변경이 이 파일을 보지 않고도 광고 신호를 켜지
	     못하게 하기 위해서다. AdMob(KAN-196)이 IDFA를 읽는 것은 별개 경로다 — 아래 ATT 문구. -->
	<key>GOOGLE_ANALYTICS_DEFAULT_ALLOW_AD_STORAGE</key>
	<false/>
	<key>GOOGLE_ANALYTICS_DEFAULT_ALLOW_AD_USER_DATA</key>
	<false/>
	<key>GOOGLE_ANALYTICS_DEFAULT_ALLOW_AD_PERSONALIZATION_SIGNALS</key>
	<false/>

	<!-- AdMob (KAN-196). 앱 ID는 SDK가 초기화 시점에 이 키에서 읽는다 — 안드로이드 매니페스트의
	     `com.google.android.gms.ads.APPLICATION_ID` meta-data 자리다. 값의 출처는 Config/Base.xcconfig이고
	     **기본은 Google 테스트 앱 ID**다(카카오 키와 달리 빈 값이 아니다 — 그쪽 주석 참고).
	     광고 단위 둘은 SDK가 읽는 키가 아니라 우리가 AppConfig.swift에서 읽는 값이라 이름을 우리
	     식으로 뒀다 (WEB_URL과 같은 사슬). -->
	<key>GADApplicationIdentifier</key>
	<string>$(ADMOB_APP_ID)</string>
	<key>ADMOB_INTERSTITIAL_ID</key>
	<string>$(ADMOB_INTERSTITIAL_ID)</string>
	<key>ADMOB_REWARDED_ID</key>
	<string>$(ADMOB_REWARDED_ID)</string>

	<!-- 추적 허용 안내 문구 (KAN-196). ATT 프롬프트는 시트에서 「맞춤형 광고 허용」을 고른 직후에만
	     뜬다 (Ads/AdsController.swift) — 거부를 고른 사람에게는 추적 자체가 없어 묻지 않는다.
	     문구는 웹 동의 시트(web/src/ads/adConsentText.ts AD_CONSENT_EFFECT)와 같은 취지다:
	     거부의 결과를 숨기지 않되 거부를 나쁜 선택처럼 읽히게 하지 않는다. -->
	<key>NSUserTrackingUsageDescription</key>
	<string>허용하시면 관심사에 맞는 광고를 보여 드려요. 허용하지 않으셔도 광고는 나오지만 맞춤형이 아닌 일반 광고만 나와요.</string>

