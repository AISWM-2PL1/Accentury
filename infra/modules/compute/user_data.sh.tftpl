#!/bin/bash
# EC2 첫 부팅 부트스트랩 (KAN-124, 역할별 호스트 KAN-36). docker와 compose를 깔고 이 역할의 compose 파일과
# 기동 스크립트를 /opt/accentury에 놓고 systemd 유닛을 등록한다. IMAGE_TAG는 파이프라인(KAN-128) 몫이라
# 그 전까지 유닛은 실패한 채 기다린다. ai 역할은 iptables egress 가드와 health 지표 타이머를 더 놓는다.
# cloud-init은 인스턴스당 한 번만 돈다 - 여기 든 파일이 바뀌면 인스턴스가 교체된다 (main.tf).
# 이 파일은 압축 없이 user_data 16KB 상한에 든다 - 긴 설명은 main.tf와 infra/README.md에 둔다.
set -euxo pipefail

dnf install -y docker
systemctl enable --now docker
usermod -aG docker ec2-user

# docker compose 플러그인 (AL2023 dnf에는 없다). 버전은 재현성을 위해 고정.
mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL "https://github.com/docker/compose/releases/download/${compose_version}/docker-compose-linux-x86_64" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

# ---- 환경별 값 (비밀 아님). accentury-up.sh와 ai 스크립트가 source 한다. ----
mkdir -p /etc/accentury
cat > /etc/accentury/env.conf <<'CONF'
ACCENTURY_ENV=${env}
ACCENTURY_ROLE=${role}
SSM_PREFIX=${ssm_prefix}
ECR_REGISTRY=${ecr_registry}
AWS_REGION=${region}
METRIC_NAMESPACE=${metric_namespace}
%{ if role == "ai" ~}
AI_DNS_NAME=${ai_dns_name}
AI_ZONE_ID=${ai_zone_id}
VPC_CIDR=${vpc_cidr}
%{ endif ~}
CONF

# ---- 운영 compose 파일(docker-compose.${role}.yml)과 기동 스크립트 - gzip + base64 (KAN-129 리뷰) ----
# 호스트 경로는 역할과 무관하게 같다 - 기동 스크립트와 파이프라인 remote 스크립트가 경로 하나만 안다.
mkdir -p /opt/accentury
echo '${compose_yml_b64}' | base64 -d | gunzip > /opt/accentury/docker-compose.yml
echo '${up_script_b64}' | base64 -d | gunzip > /opt/accentury/accentury-up.sh
chmod 755 /opt/accentury/accentury-up.sh

%{ if role == "ai" ~}
# ---- ai 전용: 컨테이너 egress 가드 + health 지표 타이머 (KAN-36) ----
echo '${guard_script_b64}' | base64 -d | gunzip > /opt/accentury/ai-egress-guard.sh
echo '${health_script_b64}' | base64 -d | gunzip > /opt/accentury/ai-health-metric.sh
chmod 755 /opt/accentury/ai-egress-guard.sh /opt/accentury/ai-health-metric.sh

# docker 뒤, compose 앞에 규칙을 넣는다. 실패하면 accentury.service도 뜨지 않는다 (Requires).
cat > /etc/systemd/system/accentury-egress-guard.service <<'UNIT'
[Unit]
Description=Accentury ai container egress guard (iptables DOCKER-USER)
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/accentury/ai-egress-guard.sh

[Install]
WantedBy=multi-user.target
UNIT

cat > /etc/systemd/system/accentury-ai-health.service <<'UNIT'
[Unit]
Description=Accentury ai health probe -> CloudWatch (KAN-36)

[Service]
Type=oneshot
ExecStart=/opt/accentury/ai-health-metric.sh
UNIT

# 1분마다. 첫 실행은 이미지 pull과 기동 시간을 준 뒤다.
cat > /etc/systemd/system/accentury-ai-health.timer <<'UNIT'
[Unit]
Description=Accentury ai health probe every minute (KAN-36)

[Timer]
OnBootSec=90s
OnUnitActiveSec=60s
AccuracySec=5s

[Install]
WantedBy=timers.target
UNIT
%{ endif ~}

# ---- systemd: 부팅마다 SSM 값을 새로 읽어 compose up ----
cat > /etc/systemd/system/accentury.service <<'UNIT'
[Unit]
Description=Accentury ${role} (docker compose)
%{ if role == "ai" ~}
Requires=docker.service accentury-egress-guard.service
After=docker.service accentury-egress-guard.service network-online.target
%{ else ~}
Requires=docker.service
After=docker.service network-online.target
%{ endif ~}
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/accentury
ExecStart=/opt/accentury/accentury-up.sh
# 배포(KAN-128): SSM IMAGE_TAG 갱신 후 `systemctl reload accentury` - 바뀐 서비스만 다시 만든다.
ExecReload=/opt/accentury/accentury-up.sh
ExecStop=/usr/bin/docker compose --env-file /run/accentury/compose.env down
# 첫 기동은 이미지 pull(backend 약 600MB, 실모델 ai 약 8.5GB)이 포함된다.
TimeoutStartSec=900
# compose down이 backend의 stop_grace_period(110초)까지 기다린다 (KAN-166) - systemd 기본 90초면 무효가 된다.
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
%{ if role == "ai" ~}
systemctl enable accentury-egress-guard.service accentury-ai-health.timer
systemctl start accentury-ai-health.timer
%{ endif ~}
systemctl enable accentury.service
# 첫 부팅에서도 바로 시도한다 (SSM/ECR 일시 장애는 스크립트가 약 4분 백오프 재시도). IMAGE_TAG가 없으면
# 실패로 남고 파이프라인이 태그를 넣은 뒤 `systemctl start accentury`나 재부팅으로 올라온다.
systemctl start accentury.service || true
