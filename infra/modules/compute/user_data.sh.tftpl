#!/bin/bash
# EC2 첫 부팅 부트스트랩 (KAN-124). docker와 compose 플러그인을 깔고,
# /opt/accentury/docker-compose.yml이 놓이면 부팅마다 자동 기동되는
# systemd 유닛을 등록한다. compose 파일 배치와 컨테이너 기동은 KAN-124,
# KAN-128(배포 파이프라인)의 몫이다.
set -euxo pipefail

dnf install -y docker
systemctl enable --now docker
usermod -aG docker ec2-user

# docker compose 플러그인 (AL2023 dnf에는 없다). 버전은 재현성을 위해 고정.
mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL "https://github.com/docker/compose/releases/download/${compose_version}/docker-compose-linux-x86_64" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

mkdir -p /opt/accentury

cat > /etc/systemd/system/accentury.service <<'UNIT'
[Unit]
Description=Accentury backend + ai (docker compose)
Requires=docker.service
After=docker.service network-online.target
# compose 파일이 아직 배치되지 않았으면 조용히 건너뛴다 (KAN-124가 배치).
ConditionPathExists=/opt/accentury/docker-compose.yml

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/accentury
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable accentury.service
